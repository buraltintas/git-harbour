GITHARBOUR_DEV_AUTH=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=http://localhost:8080/auth/github/callback
GITHUB_WEB_CALLBACK=http://localhost:5173/#/auth/callback

# Web (set in apps/web/.env.local or the shell)
VITE_API_URL=http://localhost:8080
VITE_BASE_PATH=/
