# API
APP_ENV=development
DATABASE_URL=postgres://githarbour:githarbour@localhost:5432/githarbour?sslmode=disable
DB_MAX_CONNS=5
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
PORT=8080
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
